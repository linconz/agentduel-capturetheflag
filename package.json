{
  "name": "@agentduel/capturetheflag",
  "version": "0.1.3",
  "description": "Reusable AgentDuel capture-the-flag team and battle modules for React applications",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./team-create": {
      "types": "./dist/team-create.d.ts",
      "import": "./dist/team-create.js"
    },
    "./team-edit": {
      "types": "./dist/team-edit.d.ts",
      "import": "./dist/team-edit.js"
    },
    "./team-list": {
      "types": "./dist/team-list.d.ts",
      "import": "./dist/team-list.js"
    },
    "./team-detail": {
      "types": "./dist/team-detail.d.ts",
      "import": "./dist/team-detail.js"
    },
    "./recent-battles": {
      "types": "./dist/recent-battles.d.ts",
      "import": "./dist/recent-battles.js"
    },
    "./styles.css": "./dist/assets/styles.css"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build": "npm run clean && tsc -p tsconfig.build.json && vite build",
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "pack:check": "npm pack --dry-run"
  },
  "peerDependencies": {
    "react": ">=18.2.0",
    "react-dom": ">=18.2.0"
  },
  "dependencies": {
    "@agentduel/component": "^0.1.0",
    "i18next": "^26.3.2",
    "react-i18next": "^17.0.8"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.4",
    "postcss-prefix-selector": "^2.1.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "typescript": "^6.0.3",
    "vite": "^6.3.5",
    "vite-plugin-lib-inject-css": "^2.2.2",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
